{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite"
    },
    "server": {
      "root": "server",
      "entrypoint": "index.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "server", "path": "/api/$1" }
    },
    {
      "source": "/socket.io/(.*)",
      "destination": { "service": "server", "path": "/socket.io/$1" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "client" }
    }
  ]
}
